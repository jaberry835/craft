<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title><%= report.title %></title>
    <style>
      :root {
        --ink: #102338;
        --muted: #546678;
        --paper: #f5f2ea;
        --accent: #8d6a1d;
      }
      body {
        margin: 0;
        font-family: Georgia, "Times New Roman", serif;
        background: linear-gradient(180deg, #e7ebef 0%, #f5f2ea 100%);
        color: var(--ink);
      }
      main {
        max-width: 840px;
        margin: 32px auto;
        background: rgba(255, 255, 255, 0.92);
        border: 1px solid rgba(16, 35, 56, 0.15);
        box-shadow: 0 24px 60px rgba(16, 35, 56, 0.12);
        padding: 40px 48px;
      }
      header {
        border-bottom: 3px double rgba(16, 35, 56, 0.2);
        padding-bottom: 18px;
        margin-bottom: 24px;
      }
      .eyebrow {
        color: var(--accent);
        font-size: 12px;
        letter-spacing: 0.24em;
        text-transform: uppercase;
      }
      h1 {
        margin: 8px 0;
        font-size: 32px;
        line-height: 1.1;
      }
      .meta {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px 18px;
        color: var(--muted);
        font-size: 14px;
      }
      .meta-card {
        padding: 12px 14px;
        background: rgba(16, 35, 56, 0.04);
        border-left: 3px solid rgba(141, 106, 29, 0.55);
      }
      section {
        margin-top: 28px;
      }
      h2 {
        margin-bottom: 12px;
        font-size: 18px;
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }
      p {
        line-height: 1.7;
        margin: 0 0 16px;
      }
      ul {
        padding-left: 18px;
      }
      .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        padding: 0;
        list-style: none;
      }
      .tags li {
        padding: 6px 10px;
        border: 1px solid rgba(16, 35, 56, 0.15);
        background: rgba(255, 255, 255, 0.78);
        font-size: 13px;
      }
    </style>
  </head>
  <body>
    <main>
      <header>
        <div class="eyebrow">Institutional Report</div>
        <h1><%= report.title %></h1>
        <div class="meta">
          <div class="meta-card"><strong>Issued:</strong><br /><%= createdAtDisplay %></div>
          <div class="meta-card"><strong>Author:</strong><br /><%= author.fullName %>, <%= author.title %></div>
          <div class="meta-card"><strong>Organization:</strong><br /><%= organization.name %></div>
          <div class="meta-card"><strong>Country:</strong><br /><%= country.name %></div>
        </div>
      </header>
      <section>
        <h2>Executive Summary</h2>
        <p><%= report.summary %></p>
      </section>
      <section>
        <h2>Findings</h2>
        <% for (const paragraph of report.body) { %>
          <p><%= paragraph %></p>
        <% } %>
      </section>
      <section>
        <h2>Tags</h2>
        <ul class="tags">
          <% for (const tag of report.subjectTags) { %>
            <li><%= tag %></li>
          <% } %>
        </ul>
      </section>
      <section>
        <h2>Referenced Entities</h2>
        <ul>
          <% for (const label of relatedEntityLabels) { %>
            <li><%= label %></li>
          <% } %>
        </ul>
      </section>
    </main>
  </body>
</html>