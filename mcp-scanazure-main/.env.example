# Phase 1 uses DefaultAzureCredential. Run `az login` before starting locally.
AUTH_MODE=none
HOST=127.0.0.1
PORT=3001

# Commercial test profile. Replace with cloud-profiles/airgap.json in production.
AZURE_CLOUD_PROFILE=cloud-profiles/azurecloud.json
AZURE_TENANT_ID=
MANAGED_IDENTITY_CLIENT_ID=

# Required for AUTH_MODE=obo or AUTH_MODE=arm-token.
ENTRA_SERVER_CLIENT_ID=
ENTRA_ALLOWED_CLIENT_IDS=
ENTRA_RESOURCE_URI=

# Local OBO development only. Leave empty on App Service to use its managed
# identity as a federated client assertion.
ENTRA_CLIENT_SECRET=

# Exact SPA origins. Wildcards are intentionally unsupported.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Optional cloud-profile overrides:
# ARM_ENDPOINT=
# ARM_AUDIENCE=
# AUTHORITY_HOST=
# PORTAL_URL=
# GRAPH_ENDPOINT=
# KEYVAULT_AUDIENCE=

SUBSCRIPTIONS_API_VERSION=2022-12-01
RESOURCE_GRAPH_API_VERSION=2022-10-01
RESOURCE_GRAPH_MAX_RETRIES=3
KEYVAULT_API_VERSION=7.4
KEYVAULT_EXPIRY_WARN_DAYS=30

# Phase 6 NIST detection. Add air-gap-specific initiative IDs and display-name patterns.
NIST_INITIATIVE_IDS=179d1daa-458f-4e47-8086-2a68d0d6c38f
NIST_NAME_PATTERNS=NIST SP 800-53 Rev. 5,NIST SP 800-53 R5,NIST 800-53 Rev. 5

# Portal blade paths are cloud-configurable. Supported placeholders:
# resource: {tenant}, {resourceId}; policy compliance: {assignmentId}
PORTAL_RESOURCE_PATH_TEMPLATE=/#{tenant}/resource{resourceId}
PORTAL_POLICY_COMPLIANCE_PATH_TEMPLATE=/#view/Microsoft_Azure_Policy/PolicyComplianceDetailedBlade/id/{assignmentId}
PORTAL_POLICY_OVERVIEW_PATH=/#view/Microsoft_Azure_Policy/PolicyMenuBlade/~/Compliance
PORTAL_DEFENDER_PATH=/#view/Microsoft_Azure_Security/SecurityMenuBlade/~/0
PORTAL_DEFENDER_REGULATORY_PATH=/#view/Microsoft_Azure_Security/SecurityMenuBlade/~/22

# Bounded in-memory asynchronous scan storage.
SCAN_CACHE_TTL_MINUTES=60
SCAN_MAX_SCANS=20
SCAN_MAX_SCANS_PER_CALLER=5
SCAN_MAX_MEMORY_MB=128
SCAN_CONCURRENCY=3
MCP_RATE_LIMIT_WINDOW_SECONDS=60
MCP_RATE_LIMIT_MAX_REQUESTS=120

ALLOW_UNAUTHENTICATED_REMOTE=false
