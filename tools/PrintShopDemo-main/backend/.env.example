# ──────────────────────────────────────────────────────────────
# PixelPress AI Backend — Environment Configuration
# ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
#
# Option A: Azure OpenAI endpoint (standard resource)
AZURE_OPENAI_ENDPOINT=https://jb-foundry.services.ai.azure.com/
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=gpt-5.2
# Uncomment for API-key auth (otherwise DefaultAzureCredential is used):
# AZURE_OPENAI_API_KEY=

# Option B: Azure AI Foundry project endpoint (uncomment to use instead)
# AZURE_AI_PROJECT_ENDPOINT=https://YOUR-PROJECT.services.ai.azure.com
# AZURE_OPENAI_RESPONSES_DEPLOYMENT_NAME=gpt-4o

# ──────────────────────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
