// Sample: Local Junior agent talking directly to Azure OpenAI / Foundry, bearer auth (VS Code sign-in).
//
// What this configures:
//   - junior.agentProvider:                   local                  (Junior's built-in agent loop)
//   - junior.azureOpenAI.provider:            direct                 (calls the resource URL directly)
//   - junior.azureOpenAI.authMode:            vscode-auth-session    (Junior gets a token from VS Code per request)
//   - junior.azureOpenAI.authProviderId:      microsoft              (or "microsoft-sovereign-cloud" for gov)
//   - junior.azureOpenAI.authScopes:          token audience matching the resource
//
// Required RBAC (the signed-in principal needs an inference role on the resource):
//   - *.openai.azure.com / *.cognitiveservices.azure.com
//       role:  Cognitive Services OpenAI User
//       scope: https://cognitiveservices.azure.com/.default
//   - *.services.ai.azure.com
//       role:  Cognitive Services User
//       scope: https://ai.azure.com/.default
//
// Setup steps:
//   1. Copy the relevant entries into your settings.json.
//   2. Replace the endpoint with your resource URL.
//   3. Pick the scope that matches your endpoint (see RBAC table above).
//   4. Run "Junior: Sign In for Azure/APIM Bearer Mode" once to establish the VS Code sign-in.
//
// Alternative: "junior.azureOpenAI.authMode": "bearer-token" with junior.azureOpenAI.bearerToken
// for a raw token from another system (less recommended).
{
    "microsoft-sovereign-cloud.environment": "custom",
    "microsoft-sovereign-cloud.customEnvironment": {
        "name": "Gov",
        "portalUrl": "https://portal.azure.us",
        "activeDirectoryEndpointUrl": "https://login.microsoftonline..gov/",
        "activeDirectoryResourceId": "https://management.azure..gov/",
        "resourceManagerEndpointUrl": "https://management.azure..gov/",
        "managementEndpointUrl": "https://management.azure..gov/"
    },
    "junior.agentProvider": "local",

    "junior.azureOpenAI.provider": "direct",
    "junior.azureOpenAI.endpoint": "https://<your-resource>.cognitiveservices.azure.com",
    "junior.azureOpenAI.apiVersion": "2025-03-01-preview",

    "junior.azureOpenAI.authMode": "vscode-auth-session",
    "junior.azureOpenAI.bearerTokenSource": "vscode-auth-session",
    "junior.azureOpenAI.authProviderId": "microsoft-sovereign-cloud",
    "junior.azureOpenAI.authScopes": [
        "https://cognitiveservices.azure.<suffix>/.default",
        "VSCODE_CLIENT_ID:<new-vscode-client-app-id>",
        "VSCODE_TENANT:<tenant-id>"
    ],

    "junior.azureOpenAI.deployments": [
        {
            "name": "GPT-4o",
            "deploymentId": "gpt-4o",
            "apiVersion": "2025-03-01-preview",
            "supportsReasoning": false
        }
    ],
    "junior.azureOpenAI.activeDeployment": "gpt-4o",
    "junior.inlineCompletions.deployment": "gpt-4o",

    // ── Optional: browser and web research tools ─────────────────────────
    // Leave searchUrlTemplates empty to use Junior's public default, or point
    // it at your intranet search page. {query} is URL-encoded automatically.
    "junior.browser.searchUrlTemplates": [],
    // "junior.browser.searchUrlTemplates": ["https://search.contoso.local/?q={query}"],
    "junior.browser.openPreview": true,
    "junior.browser.useClientCertificate": false

    // -------------------------------------------------------------------------
    // Optional: opt into the new /openai/v1/responses wire API.
    // Requires a reasoning-capable deployment (gpt-5.x / o-series) for the
    // "Thinking" panel to populate. Lower reasoningEffort = faster.
    //
    // To enable: add a comma to the line above, then uncomment the block:
    //
    // "junior.azureOpenAI.wireApi": "responses",
    // "junior.azureOpenAI.reasoningEffort": "medium",
    // "junior.azureOpenAI.reasoningSummary": "auto",
    // "junior.azureOpenAI.useServerSideState": true
    // -------------------------------------------------------------------------
}
