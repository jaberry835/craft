# Azure OpenAI model connection used by config/agent-connections.json
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=your-chat-deployment
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Required only when config/agent-connections.json sets authMode to "api-key".
# With authMode "entra", DefaultAzureCredential is used instead.
AZURE_OPENAI_API_KEY=

# Chat sessions remain project-partitioned JSON files under data/ by default.
# Set all four required values below to select Cosmos DB. Use a dedicated AAA
# database/container with native /projectId partitioning; do not point these
# defaults at Junior Web's shared ChatSessions container.
COSMOS_DB_ENDPOINT=https://your-account.documents.azure.com:443/
COSMOS_DB_DATABASE=AaaChat
COSMOS_DB_CHAT_CONTAINER=AaaChatSessions
COSMOS_DB_AUTH_MODE=entra

# Native is the recommended clean AAA schema. Use junior-compatible only when
# intentionally targeting a container partitioned by /partitionKey.
COSMOS_DB_CHAT_SCHEMA_MODE=native

# When true, AAA creates the configured database/container if absent, then
# validates the exact partition path. Existing mismatched containers fail.
COSMOS_DB_AUTO_CREATE=false

# Used only by junior-compatible mode. This is a non-secret stable owner prefix.
COSMOS_DB_OWNER_ID=aaa

# Required only when COSMOS_DB_AUTH_MODE=api-key. Prefer Entra authentication
# with DefaultAzureCredential for deployed environments.
COSMOS_DB_KEY=

# Compatibility settings copied from Junior Web for the future project-file
# storage abstraction. AAA reports blob configuration readiness at
# /api/storage/status, but project files remain local (active=false) for now.
JUNIOR_WORKSPACE_STORAGE_BACKEND=local
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_BLOB_SERVICE_URL=https://your-storage-account.blob.core.windows.net
JUNIOR_WORKSPACE_BLOB_CONTAINER=aaa-workspaces
JUNIOR_WORKSPACE_BLOB_PREFIX=projects
JUNIOR_WORKSPACE_LOCAL_CACHE_ROOT=C:\path\to\aaa-workspaces-cache
