{
  "name": "aaa-security-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "node --watch --import tsx server/index.ts",
    "build": "tsc -b && vite build",
    "start": "node dist/server/server/index.js",
    "test:server": "tsx --test server/test/**/*.test.ts",
    "test:mcp-live": "tsx --test --test-name-pattern \"live MCP\" server/test/mcpHttpClient.test.ts",
    "model:probe": "tsx server/modelProbe.ts",
    "lint": "eslint .",
    "preview": "npm run start"
  },
  "dependencies": {
    "@azure/cosmos": "^4.9.3",
    "@azure/identity": "^4.13.1",
    "@azure/msal-browser": "^5.23.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "lucide-react": "^0.468.0",
    "playwright-core": "^1.63.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.3.6"
  }
}
