{
  "metadata": {
    "name": "Organization password policy overlay",
    "version": "2026.08.31",
    "precedence": "Overrides baseline password and account lockout values."
  },
  "passwordPolicy": {
    "MinimumPasswordAge": 1,
    "MaximumPasswordAge": 60,
    "MinimumPasswordLength": 15,
    "PasswordComplexity": 1,
    "PasswordHistorySize": 24
  },
  "accountLockoutPolicy": {
    "LockoutBadCount": 5,
    "ResetLockoutCount": 15,
    "LockoutDuration": 15
  }
}
