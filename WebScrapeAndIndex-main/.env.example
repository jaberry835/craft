# Azure AI Search settings
# Commercial: https://<name>.search.windows.net
# Azure Gov:  https://<name>.search.windows.us
AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.us
AZURE_SEARCH_INDEX_NAME=<your-search-index-name>
# Optional: omit to use DefaultAzureCredential (az login, managed identity, etc.)
AZURE_SEARCH_API_KEY=

# Audience for credential-based auth (only needed when API key is omitted)
# Commercial: https://search.azure.com
# Azure Gov:  https://search.azure.us
AZURE_SEARCH_AUDIENCE=https://search.azure.us

# OpenAI / Azure OpenAI settings for embeddings
# Commercial: https://<name>.openai.azure.com
# Azure Gov:  https://<name>.openai.azure.us
AZURE_OPENAI_ENDPOINT=https://<your-openai-resource>.openai.azure.us
# Optional: omit to use DefaultAzureCredential
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002

# Token scope for DefaultAzureCredential (only needed when API keys are omitted)
# Commercial: https://cognitiveservices.azure.com/.default
# Azure Gov:  https://cognitiveservices.azure.us/.default
AZURE_OPENAI_TOKEN_SCOPE=https://cognitiveservices.azure.us/.default

# Scraping defaults
AGENT_ID=default-agent
SOURCE_NAME=web-scrape
