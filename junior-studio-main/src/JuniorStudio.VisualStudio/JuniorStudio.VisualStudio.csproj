  <!--
    Publish the .NET 8 sidecar (JuniorStudio.Agent) into Assets\Agent\ before the VSIX is packaged,
    then mark its contents as VSIX-included content. Sidecar is framework-dependent (uses installed .NET 8 runtime).
  -->
  <PropertyGroup>
    <AgentProjectDir>$(MSBuildProjectDirectory)\..\JuniorStudio.Agent</AgentProjectDir>
    <AgentPublishDir>$(MSBuildProjectDirectory)\Assets\Agent</AgentPublishDir>
  </PropertyGroup>

  <Target Name="PublishJuniorAgent" BeforeTargets="ResolveAssemblyReferences;BeforeBuild" Inputs="$(AgentProjectDir)\JuniorStudio.Agent.csproj;$(AgentProjectDir)\Program.cs;$(AgentProjectDir)\AgentHost.cs;$(AgentProjectDir)\Protocol.cs" Outputs="$(AgentPublishDir)\JuniorStudio.Agent.exe">
    <Message Text="Publishing JuniorStudio.Agent sidecar to $(AgentPublishDir)" Importance="high" />
    <RemoveDir Directories="$(AgentPublishDir)" Condition="Exists('$(AgentPublishDir)')" />
    <Exec Command="dotnet publish &quot;$(AgentProjectDir)\JuniorStudio.Agent.csproj&quot; -c $(Configuration) -r win-x64 --no-self-contained -o &quot;$(AgentPublishDir)&quot; -v minimal" />
  </Target>

  <Target Name="IncludeAgentInVsix" AfterTargets="PublishJuniorAgent" BeforeTargets="GetVsixSourceItems">
    <ItemGroup>
      <_AgentFiles Include="$(AgentPublishDir)\**\*" />
      <Content Include="@(_AgentFiles)">
        <Link>Assets\Agent\%(RecursiveDir)%(FileName)%(Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <IncludeInVSIX>true</IncludeInVSIX>
      </Content>
    </ItemGroup>
  </Target>

  <!--
    Copy native WebView2Loader.dll into the VSIX. NuGet's runtimes\win-x64\native is not auto-deployed
    for .NET Framework projects, and missing it causes WebView2 BuildWindowCore to throw
    FileNotFoundException whenever the WPF host re-parents the control (e.g. when VS opens a project),
    crashing devenv.exe.
  -->
  <Target Name="IncludeWebView2NativeLoader" BeforeTargets="GetVsixSourceItems;CopyFilesToOutputDirectory">
    <PropertyGroup>
      <_NuGetRoot Condition="'$(NuGetPackageRoot)' != ''">$(NuGetPackageRoot)</_NuGetRoot>
      <_NuGetRoot Condition="'$(_NuGetRoot)' == ''">$(USERPROFILE)\.nuget\packages\</_NuGetRoot>
      <WebView2LoaderSource>$(_NuGetRoot)microsoft.web.webview2\1.0.3405.78\runtimes\win-x64\native\WebView2Loader.dll</WebView2LoaderSource>
    </PropertyGroup>
    <Message Text="WebView2Loader source: $(WebView2LoaderSource) (exists=$([System.IO.File]::Exists('$(WebView2LoaderSource)')))" Importance="high" />
    <ItemGroup Condition="Exists('$(WebView2LoaderSource)')">
      <Content Include="$(WebView2LoaderSource)">
        <Link>WebView2Loader.dll</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <IncludeInVSIX>true</IncludeInVSIX>
      </Content>
    </ItemGroup>
  </Target>
</Project>