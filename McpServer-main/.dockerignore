# .dockerignore – files excluded from the Docker build context.
# Keeping the context small speeds up builds and prevents secrets leaking in.

# Python artefacts
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg

# Virtual environments
.venv/
venv/
env/

# Test and dev files – not needed in the production image
tests/
*.test.py
.pytest_cache/
.coverage
htmlcov/

# Local secrets – NEVER bake .env into the image
.env
.env.*
!.env.example

# Version control
.git/
.gitignore

# Editor configs
.vscode/
.idea/
*.swp

# Docker files themselves
Dockerfile
.dockerignore

# Documentation and CI
README.md
*.md
.github/
