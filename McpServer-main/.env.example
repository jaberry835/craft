# .env.example
# ============
# Copy this file to .env for local development:
#   cp .env.example .env
#
# Then edit .env with your actual values.
# NEVER commit .env to source control – add it to .gitignore.
#
# In Azure (Container Apps / App Service), set these as Application Settings
# or reference them from Key Vault using @Microsoft.KeyVault(SecretUri=...).
# ============================================================================

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
SERVER_NAME=my-mcp-server
SERVER_INSTRUCTIONS=An MCP server providing tools for your application.
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# CORS
# In development, ["*"] is fine.
# In production, replace with your actual front-end or AI agent origins:
#   CORS_ORIGINS=["https://my-app.azurewebsites.net","https://portal.azure.com"]
# ---------------------------------------------------------------------------
CORS_ORIGINS=["*"]

# ---------------------------------------------------------------------------
# Authentication – Generic OIDC Bearer Token (works with any provider)
# See auth/verifier.py GenericOidcBearerTokenMiddleware.
#
# Entra ID:   OIDC_JWKS_URI=https://login.microsoftonline.com/<tenant>/discovery/v2.0/keys
#             OIDC_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
#             OIDC_AUDIENCE=api://<client-id>
# Cognito:    OIDC_JWKS_URI=https://cognito-idp.<region>.amazonaws.com/<pool-id>/.well-known/jwks.json
#             OIDC_ISSUER=https://cognito-idp.<region>.amazonaws.com/<pool-id>
#             OIDC_AUDIENCE=<app-client-id>
# Okta:       OIDC_JWKS_URI=https://<domain>/oauth2/default/v2/keys
#             OIDC_ISSUER=https://<domain>/oauth2/default
#             OIDC_AUDIENCE=api://default
# Auth0:      OIDC_JWKS_URI=https://<domain>/.well-known/jwks.json
#             OIDC_ISSUER=https://<domain>/
#             OIDC_AUDIENCE=https://<your-api-identifier>
# ---------------------------------------------------------------------------
# OIDC_JWKS_URI=
# OIDC_ISSUER=
# OIDC_AUDIENCE=

# ---------------------------------------------------------------------------
# Authentication – Entra ID convenience wrapper (computes OIDC URLs from tenant)
# Use EITHER the generic OIDC fields above OR these Entra-specific fields.
# See auth/verifier.py EntraIDBearerTokenMiddleware (wraps GenericOidcBearerTokenMiddleware).
# AZURE_CLIENT_ID and AZURE_CLIENT_SECRET are also needed for Layer 2 OBO flows.
# ---------------------------------------------------------------------------
# AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# AZURE_CLIENT_SECRET=your-client-secret-here
# EXPECTED_AUDIENCE=api://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Authentication – Client Certificate (alternative to Entra ID)
# See auth/verifier.py ClientCertificateMiddleware.
# ---------------------------------------------------------------------------
# CERT_HEADER=X-ARR-ClientCert
# ALLOWED_CERT_ISSUERS=["CN=My Enterprise CA, O=Contoso"]
# ALLOWED_CERT_THUMBPRINTS=["abcdef0123456789..."]

# ---------------------------------------------------------------------------
# Authentication – Simple API Key (alternative to Entra ID)
# See auth/verifier.py ApiKeyMiddleware.
# ---------------------------------------------------------------------------
# API_KEY=your-secret-api-key-here

# ---------------------------------------------------------------------------
# External API base URLs (fictional api in this case)
# Add one variable per downstream service your tools call.
# ---------------------------------------------------------------------------
ECHO_API_BASE_URL=

# Secure API example variables – see tools/secure_api.py and auth/user_cert_context.py
# for the working cert flow. Use the secure API repo to create test certs, copy them
# into a certs/ folder, then set these variables.
SECURE_API_BASE_URL=https://localhost:5005
SECURE_API_CALLER_CERT_PATH=certs/caller.crt
SECURE_API_CALLER_KEY_PATH=certs/caller.key
SECURE_API_CA_CERT_PATH=certs/ca.crt
SECURE_API_CERTS_DIR=certs

