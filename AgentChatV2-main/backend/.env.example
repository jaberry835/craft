# =============================================================================
# AgentChatV2 Backend Configuration
# Copy this file to .env and configure for your environment
# =============================================================================
# 
# AZURE CLOUD ENVIRONMENTS
# This application supports both Azure Commercial and Azure Government.
# Update the following settings based on your cloud:
#
# AZURE COMMERCIAL:
#   AZURE_AUTHORITY_HOST=https://login.microsoftonline.com
#   AZURE_COGNITIVE_SERVICES_SCOPE=https://cognitiveservices.azure.com/.default
#   Endpoints use: .azure.com, .windows.net, .documents.azure.com
#
# AZURE GOVERNMENT:
#   AZURE_AUTHORITY_HOST=https://login.microsoftonline.us
#   AZURE_COGNITIVE_SERVICES_SCOPE=https://cognitiveservices.azure.us/.default
#   Endpoints use: .azure.us, .windows.us, .documents.azure.us
#
# SOVEREIGN / CUSTOM CLOUDS:
#   Set the above vars for your cloud, plus:
#   AZURE_ARM_ENDPOINT=https://management.<your-cloud-domain>
#   AZURE_ARM_SCOPE=https://management.<your-cloud-domain>/.default
#   These are required for AOAI deployment discovery in non-standard clouds.
#
# =============================================================================

# Flask/FastAPI Settings
# Runtime environment.
# Use production for deployed environments.
# Use development for local runs only.
ENVIRONMENT=production
# Development-only auth/admin bypass. Keep false in production.
# When true, requests without Bearer tokens are allowed ONLY if ENVIRONMENT=development.
ALLOW_DEV_AUTH_BYPASS=false
LOG_LEVEL=INFO

# =============================================================================
# Logging Toggles
# Enable verbose logging for specific categories. Set to true/false.
# Keeping these false keeps logs clean for debugging.
# =============================================================================
SHOW_PERFORMANCE_LOGS=false  # Detailed timing for AOAI, MCP, CosmosDB, etc.
SHOW_AUTH_LOGS=false         # Token validation, header processing
SHOW_A2A_LOGS=false          # A2A discovery, calls, responses
SHOW_MCP_LOGS=false          # MCP headers, discovery, tool calls
SHOW_AGENT_LOGS=false        # Agent execution, tool calls, chatter events

#add CORS origins for local dev and production (comma-separated)
CORS_ORIGINS=http://localhost:4200
# Azure Government Endpoints
AZURE_AUTHORITY_HOST=https://login.microsoftonline.us

# Microsoft Entra ID (for token validation)
# Note: Authentication uses managed identity in production, Azure CLI locally
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
# add client id for user managed identity if not using system assigned identity
AZURE_MANAGED_IDENTITY_CLIENT_ID=

# OBO (On-Behalf-Of) credentials for cross-app-registration A2A calls
# Only needed when calling external A2A agents registered under a different app registration.
# Development: use client certificate (.pfx) — preferred over secret
AZURE_CLIENT_CERTIFICATE_PATH=
AZURE_CLIENT_CERTIFICATE_PASSWORD=
# Production: use client secret (if no certificate is configured)
AZURE_CLIENT_SECRET=
# =============================================================================
# Azure OpenAI (Azure Government)
# Use AZURE_OPENAI_KEY for local dev, managed identity will be used in production
# NOTE: Model/deployment is configured per-agent in the Admin UI.
#       Each agent MUST have a deployment name set (e.g., gpt-4o, gpt-35-turbo).
#       The embedding deployment below is used for document search/RAG.
# =============================================================================
AZURE_OPENAI_ENDPOINT=https://your-openai.openai.azure.us/
AZURE_OPENAI_KEY=your-openai-api-key
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002

# Azure Cognitive Services token scope (for managed identity auth)
# Azure Commercial: https://cognitiveservices.azure.com/.default
# Azure Government: https://cognitiveservices.azure.us/.default
AZURE_COGNITIVE_SERVICES_SCOPE=https://cognitiveservices.azure.us/.default

# Azure Resource Manager (ARM) overrides for sovereign/custom clouds.
# Required for AOAI deployment auto-discovery when your endpoint URL
# doesn't end in .azure.com, .azure.us, or .azure.cn.
# Leave blank for Commercial/Government/China (auto-detected from endpoint URL).
# Examples:
#   AZURE_ARM_ENDPOINT=https://management.azure.eaglex.ic.gov
#   AZURE_ARM_SCOPE=https://management.azure.eaglex.ic.gov/.default
AZURE_ARM_ENDPOINT=
AZURE_ARM_SCOPE=

# =============================================================================
# Azure Cosmos DB
# Use CONNECTION_STRING for local dev, ENDPOINT with managed identity for production
# =============================================================================
AZURE_COSMOS_DB_CONNECTION_STRING=AccountEndpoint=https://your-cosmos.documents.azure.us:443/;AccountKey=your-account-key;
AZURE_COSMOS_DB_ENDPOINT=
AZURE_COSMOS_DB_DATABASE=AgentChatV2
AZURE_COSMOS_DB_AGENTS_CONTAINER=Agents
AZURE_COSMOS_DB_SESSIONS_CONTAINER=Sessions
AZURE_COSMOS_DB_MESSAGES_CONTAINER=Messages

# =============================================================================
# Azure AI Search (for document embeddings)
# Use AZURE_SEARCH_KEY for local dev, managed identity will be used in production
# AZURE_SEARCH_SCOPE: gov=https://search.azure.us/.default, com=https://search.azure.com/.default
# =============================================================================
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.us
AZURE_SEARCH_KEY=your-search-admin-key
AZURE_SEARCH_INDEX_NAME=documents
AZURE_SEARCH_SCOPE=https://search.azure.com/.default

# =============================================================================
# Azure Document Intelligence (rich layout-aware extraction)
# Extracts structured text from PDFs, scanned images, Office docs with table/heading awareness.
# Uses managed identity in production; set KEY for local dev if needed.
# Leave ENDPOINT empty to disable (falls back to local parsers: pymupdf, openpyxl, etc.)
# =============================================================================
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-doc-intel.cognitiveservices.azure.us/
AZURE_DOCUMENT_INTELLIGENCE_KEY=your-doc-intel-key

# Security Token Service (SS Token / Access Checker)
# Returns list of SS tokens the user is authorized for, used to filter grounding search results.
# Local dev: http://localhost:7071/api/get-hash
# Deployed:  https://accesschecker-python.azurewebsites.us/api/user-access
ACCESS_CHECKER_ENDPOINT=http://localhost:7071/api/get-hash
# How long (in minutes) to cache a user's SS tokens. Set to 0 to always call the access checker.
ACCESS_CHECKER_CACHE_TTL=5
# =============================================================================
# Backend URL (for A2A agent-to-agent communication)
# This is the URL where this backend is accessible. Used for internal A2A calls.
# Local dev: http://localhost:5000 (default, can be omitted)
# Production: Set to the deployed App Service URL
# =============================================================================
BACKEND_URL=http://localhost:5000

# Application Insights
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Token Limits (for cost estimation)
DEFAULT_MAX_INPUT_TOKENS=8000
DEFAULT_MAX_OUTPUT_TOKENS=4000
TOKEN_COST_WARNING_THRESHOLD=10000

# =============================================================================
# Rate Limiting (slowapi format: "count/period", e.g. "60/minute", "5/second")
# Per-user limits keyed by authenticated user_id, falls back to client IP.
# =============================================================================
RATE_LIMIT_DEFAULT=60/minute        # All endpoints not explicitly limited
RATE_LIMIT_CHAT=10/minute           # /api/chat/send and /api/chat/send-sync
RATE_LIMIT_UPLOAD=20/minute         # /api/documents/upload
