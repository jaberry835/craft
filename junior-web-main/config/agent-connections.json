[
  {
    "id": "default-azure-openai",
    "name": "Default Azure OpenAI",
    "type": "azure-openai",
    "authMode": "entra",
    "endpointEnv": "AZURE_OPENAI_ENDPOINT",
    "apiKeyEnv": "AZURE_OPENAI_API_KEY",
    "deploymentEnv": "AZURE_OPENAI_DEPLOYMENT",
    "apiVersionEnv": "AZURE_OPENAI_API_VERSION",
    "defaultApiVersion": "2025-01-01-preview",
    "temperature": 0.2,
    "maxTokens": 1200
  },
  {
    "id": "default-azure-ai-search",
    "name": "Default Azure AI Search",
    "type": "azure-ai-search",
    "authMode": "entra",
    "cloud": "public",
    "endpointEnv": "AZURE_AI_SEARCH_ENDPOINT",
    "apiKeyEnv": "AZURE_AI_SEARCH_API_KEY",
    "indexNames": [
      "security-approval-index"
    ],
    "semanticConfigurations": [
      "default"
    ],
    "queryType": "semantic",
    "top": 5
  }
]
