{
  "name": "junior-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "node --watch --import tsx server/index.ts",
    "build": "tsc -b && vite build",
    "build:server": "node scripts/build-server.mjs",
    "build:deploy": "npm run build && npm run build:server && node scripts/prepare-deploy-package.mjs",
    "test:server": "tsx --test server/test/**/*.test.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "azure:bootstrap-persistence": "bash scripts/bootstrap-azure-persistence.sh",
    "azure:bootstrap-persistence:pwsh": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/bootstrap-azure-persistence.ps1",
    "azure:bootstrap-identity:pwsh": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/bootstrap-azure-identity.ps1",
    "azure:configure-appservice:pwsh": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/configure-azure-appservice-settings.ps1",
    "azure:apply-env:pwsh": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/apply-env-to-appservice.ps1",
    "azure:grant-runtime-roles:pwsh": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/grant-azure-runtime-roles.ps1",
    "azure:deploy:pwsh": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-azure-appservice.ps1"
  },
  "dependencies": {
    "@azure/cosmos": "^4.9.3",
    "@azure/identity": "^4.13.1",
    "@azure/keyvault-secrets": "^4.11.2",
    "@azure/msal-browser": "^5.11.0",
    "@azure/search-documents": "^13.0.0",
    "@azure/storage-blob": "^12.31.0",
    "@monaco-editor/react": "^4.7.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jose": "^6.2.3",
    "lucide-react": "^0.562.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10"
  }
}
