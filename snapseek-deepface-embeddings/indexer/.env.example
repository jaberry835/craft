# Azure Snap Seek Environment Configuration
# Copy this file to .env and fill in your values
#
# AUTHENTICATION: This app uses API keys first when provided.
# If no key is set, it falls back to Azure Identity (DefaultAzureCredential).
# For local development, set the *_KEY variables for simplicity.

# Azure Services
AZURE_SUBSCRIPTION_ID=your-subscription-id

# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_KEY=your-search-admin-key  # Optional if using identity
AZURE_SEARCH_INDEX_NAME=snapseek-images

# Azure Computer Vision
AZURE_CV_ENDPOINT=https://your-cv-service.cognitiveservices.azure.com
AZURE_CV_KEY=your-cv-key  # Optional if using identity

# Azure Document Intelligence
AZURE_DOC_INTEL_ENDPOINT=https://your-doc-intel.cognitiveservices.azure.com
AZURE_DOC_INTEL_KEY=your-doc-intel-key  # Optional if using identity

# Azure Face API (Optional - requires API key, identity not supported by SDK)
AZURE_FACE_ENDPOINT=https://your-face-service.cognitiveservices.azure.com
AZURE_FACE_KEY=your-face-key  # Required for Face API

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-openai.openai.azure.com
AZURE_OPENAI_KEY=your-openai-key  # Optional if using identity
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_API_VERSION=2024-02-01

# Azure Blob Storage
# Use the full URL for your cloud environment:
#   Public:  https://your-account.blob.core.windows.net
#   US Gov:  https://your-account.blob.core.usgovcloudapi.net
#   China:   https://your-account.blob.core.chinacloudapi.cn
AZURE_STORAGE_BLOB_URL=https://your-storage-account.blob.core.windows.net
AZURE_STORAGE_KEY=your-storage-account-key  # Optional if using identity
AZURE_STORAGE_CONTAINER=your-container-name
AZURE_STORAGE_ACCOUNT=your-storage-account  # Used by backend

# Image Processing (Indexer)
IMAGE_SOURCE_PATH=/path/to/images
BATCH_SIZE=10
ENABLE_FACE_DETECTION=true
ENABLE_IMAGE_EMBEDDINGS=true

# Face Embedding Settings
# Backend: "dlib" (128-dim, no download needed) or "deepface" (512-dim, requires weight download)
FACE_EMBEDDING_BACKEND=dlib
FACE_EMBEDDING_DIMENSIONS=128
ENABLE_FACE_EMBEDDINGS=true
# DEEPFACE_MODEL_NAME=Facenet512  # Only used when FACE_EMBEDDING_BACKEND=deepface

# Server Settings (Backend)
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Identity Auth Scope (only used when falling back to DefaultAzureCredential)
AZURE_CREDENTIAL_SCOPE=https://cognitiveservices.azure.com/.default

# Feature Flags
ENABLE_SEMANTIC_SEARCH=true
ENABLE_CHAT=true
