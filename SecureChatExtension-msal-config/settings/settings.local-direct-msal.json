// =============================================================================
// Junior — Scenario: LOCAL AGENT direct to Azure OpenAI / Foundry, MSAL bearer
//
// Use when:
//   - You hit the Azure OpenAI / Foundry resource directly (no APIM)
//   - You have an inference role on the resource:
//       *.cognitiveservices.azure.com  -> "Cognitive Services OpenAI User"
//                                         scope: https://cognitiveservices.azure.com/.default
//       *.services.ai.azure.com        -> "Cognitive Services User"
//                                         scope: https://ai.azure.com/.default
//
// App registration prerequisites:
//   - Public client (Mobile/desktop), redirect URI http://localhost
//   - "Allow public client flows" = Yes
//   - Either: NO API permissions needed if your app is in the same tenant as
//     the resource AND you grant the user the inference role directly (the
//     /.default scope returns whatever the resource will accept), OR
//   - Delegated permission for "Azure Cognitive Services" (user_impersonation)
//     with admin consent.
//
// Sign in with: "Junior: MSAL Sign In"
// =============================================================================
{
    // -- Models -------------------------------------------------------------
    "junior.azureOpenAI.deployments": [
        { "name": "GPT-5.2",      "deploymentId": "gpt-5.2",      "apiVersion": "2025-03-01-preview" },
        { "name": "gpt-5.4-mini", "deploymentId": "gpt-5.4-mini", "apiVersion": "2025-03-01-preview" }
    ],
    "junior.azureOpenAI.activeDeployment": "gpt-5.2",
    "junior.inlineCompletions.deployment": "gpt-5.2",

    // -- Provider: Direct (MSAL bearer) ------------------------------------
    "junior.agentProvider": "azure-openai",
    "junior.azureOpenAI.provider": "direct",
    "junior.azureOpenAI.endpoint": "https://<your-resource>.cognitiveservices.azure.com/",
    "junior.azureOpenAI.apiVersion": "2025-03-01-preview",
    "junior.azureOpenAI.authMode": "msal",
    "junior.azureOpenAI.authScopes": [
        "https://cognitiveservices.azure.com/.default"
        // For services.ai.azure.com use: "https://ai.azure.com/.default"
    ],

    // -- Shared MSAL config ------------------------------------------------
    "junior.msal.clientId": "<your-public-client-app-clientid>",
    "junior.msal.tenantId": "<your-tenant-guid-or-domain>",
    // Commercial / Gov / China — use cloudInstance (MSAL knows these hosts):
    //   Commercial : https://login.microsoftonline.com
    //   US Gov     : https://login.microsoftonline.us
    //   China      : https://login.partner.microsoftonline.cn
    "junior.msal.cloudInstance": "https://login.microsoftonline.com",
    // air-gapped / custom sovereign tenants — MSAL's built-in
    // AzureCloudInstance enum doesn't know these hosts. You MUST use `authority`
    // (full URL incl. tenant) instead of `cloudInstance`, and list the host in
    // `knownAuthorities` so MSAL will trust it (the extension also auto-adds it).
    // "junior.msal.authority": "https://login.<your-sovereign-host>/<tenant-guid>",
    // "junior.msal.knownAuthorities": ["login.<your-sovereign-host>"],
    // "junior.msal.interactiveFlow": "device-code",

    // -- Misc ---------------------------------------------------------------
    "junior.temperature": 1
}
