{
    "junior.azureOpenAI.deployments": [
        {
        "name": "GPT-5.2",
        "deploymentId": "gpt-5.2",
        "apiVersion": "2025-03-01-preview"
        },
        {
            "name": "gpt-5.4-mini",
            "deploymentId": "gpt-5.4-mini",
            "apiVersion": "2025-03-01-preview"
        }
    ],
    "junior.azureOpenAI.activeDeployment": "gpt-5.2",
    "junior.inlineCompletions.deployment": "gpt-5.2",
    "junior.mcp.includeExternalServers": true,
    "junior.mcp.externalServerSettings": [
    "mcp.servers"
    ],
    "junior.mcp.servers": {

    },

    // -------------------------------------------------------------------------
    // Local Junior agent mode: pick ONE of the blocks below.
    //
    // Like the Copilot CLI path, the bearer token audience is NOT derived from
    // the endpoint URL. It comes from junior.azureOpenAI.authScopes. Switching
    // between APIM and a direct Azure/Foundry endpoint REQUIRES updating the
    // scopes too, or the backend will return HTTP 401.
    //
    // For bearer auth, prefer authMode: "msal" — Junior owns the app
    // registration so the same setup works in commercial AAD, AzureUSGov,
    // China, AND custom sovereign tenants ( isolated dev
    // tenants) where vscode-auth-session would fail with AADSTS500113.
    // -------------------------------------------------------------------------

    // --- Option A: APIM in front of Foundry (key mode, default) --------------
    "junior.azureOpenAI.apimBaseUrl": "https://.azure-api.net/foundryapi",
    "junior.azureOpenAI.provider": "apim",
    "junior.azureOpenAI.apiVersion": "2025-03-01-preview",

    // --- Option B: APIM in front of Foundry (MSAL bearer mode) ---------------
    // Token audience must match the APIM-validated app registration.
    // "junior.azureOpenAI.provider": "apim",
    // "junior.azureOpenAI.apimBaseUrl": "https://.azure-api.net/foundryapi-bearer",
    // "junior.azureOpenAI.apiVersion": "2025-03-01-preview",
    // "junior.azureOpenAI.authMode": "msal",
    // "junior.azureOpenAI.authScopes": [
    //     "api://<apim-app-clientid>/user_impersonation"
    // ],

    // --- Option C: Direct Azure OpenAI / Foundry (MSAL bearer mode) ----------
    // The signed-in principal needs an inference role on the resource:
    //   - *.cognitiveservices.azure.com  -> Cognitive Services OpenAI User
    //                                       scope: https://cognitiveservices.azure.com/.default
    //   - *.services.ai.azure.com        -> Cognitive Services User
    //                                       scope: https://ai.azure.com/.default
    //
    // "junior.azureOpenAI.provider": "direct",
    // "junior.azureOpenAI.endpoint": "https://agent-poc-resource.cognitiveservices.azure.com/",
    // "junior.azureOpenAI.apiVersion": "2025-03-01-preview",
    // "junior.azureOpenAI.authMode": "msal",
    // "junior.azureOpenAI.authScopes": [
    //     "https://cognitiveservices.azure.com/.default"
    // ],

    "junior.temperature": 1,


    "junior.agentProvider": "copilot-cli",
    "junior.copilotCli.path": "C:\\Users\\SystemAdministrator\\AppData\\Local\\GitHubCopilotCLI\\copilot.cmd",  //in path
    "junior.copilotCli.model": "gpt-5.2",
    "junior.copilotCli.models": [
        {
            "name": "GPT-5.2",
            "id": "gpt-5.2"
        }
    ],
    "junior.copilotCli.additionalArgs": [],
    "junior.copilotCli.autoApproveWrites": false,
    "junior.copilotCli.autoApproveTerminal": false,
    "junior.copilotCli.logSdkEvents": false,
    "junior.copilotCli.providerType": "azure",

    // -------------------------------------------------------------------------
    // Copilot CLI BYOK bearer mode: pick ONE of the blocks below.
    //
    // The bearer token audience is NOT derived from providerBaseUrl. It comes
    // from providerAuthScopes. If you switch the base URL between APIM and a
    // direct Azure/Foundry endpoint, you MUST also switch the scopes, or the
    // backend will return HTTP 401.
    //
    // providerBearerTokenSource: "msal" reuses the shared junior.msal.* block
    // below. providerBearerTokenSource: "vscode-auth-session" uses VS Code's
    // built-in Microsoft provider (only works in commercial / published
    // sovereign clouds).
    // -------------------------------------------------------------------------

    // --- Option A: APIM in front of Foundry (MSAL bearer mode) ---------------
    // Token audience must match the APIM-validated app registration.
    // APIM strips the inbound Authorization header and calls Foundry using
    // its own managed identity.
    "junior.copilotCli.providerBaseUrl": "https://.azure-api.net",
    "junior.copilotCli.providerBearerTokenSource": "msal",
    "junior.copilotCli.providerAuthScopes": [
        "api://<apim-app-clientid>/user_impersonation"
    ],
    "junior.copilotCli.providerWireApi": "responses",
    // Leave providerAzureApiVersion unset for APIM mode.

    // --- Option B: Direct Azure OpenAI / Foundry (MSAL bearer mode) ----------
    // Comment out Option A above and uncomment this block.
    // The signed-in principal needs an inference role on the resource:
    //   - *.cognitiveservices.azure.com  -> Cognitive Services OpenAI User
    //                                       scope: https://cognitiveservices.azure.com/.default
    //   - *.services.ai.azure.com        -> Cognitive Services User
    //                                       scope: https://ai.azure.com/.default
    //
    // "junior.copilotCli.providerBaseUrl": "https://agent-poc-resource.cognitiveservices.azure.com/",
    // "junior.copilotCli.providerBearerTokenSource": "msal",
    // "junior.copilotCli.providerAuthScopes": [
    //     "https://cognitiveservices.azure.com/.default"
    // ],
    // "junior.copilotCli.providerWireApi": "responses",
    // "junior.copilotCli.providerAzureApiVersion": "2025-03-01-preview",

    // --- Option C: Direct with a raw API key or pasted bearer token ----------
    // "junior.copilotCli.providerApiKey": "",
    // "junior.copilotCli.providerBearerToken": "",

    // -------------------------------------------------------------------------
    // Shared MSAL (Microsoft Entra) configuration
    //
    // Used by both junior.azureOpenAI (authMode: "msal") and
    // junior.copilotCli (providerBearerTokenSource: "msal"). Tokens are
    // cached per (clientId, authority) tuple in VS Code SecretStorage and
    // survive restarts.
    //
    // App registration prerequisites:
    //   - Public client (Mobile/desktop platform), redirect URI http://localhost
    //   - "Allow public client flows" = Yes
    //   - Delegated permission for the API audience above
    //     (admin consent if your tenant requires it)
    //
    // Commands: "Junior: MSAL Sign In", "Junior: MSAL Sign Out",
    //           "Junior: MSAL Show Accounts"
    // -------------------------------------------------------------------------
    "junior.msal.clientId": "6349498a-a2f9-4081-8b82-d2119ac8f23c",
    "junior.msal.tenantId": "03f141f3-496d-4319-bbea-a3e9286cab10",

    // Pick ONE authority style below.

    // --- Commercial Azure AD (default) ---
    "junior.msal.cloudInstance": "https://login.microsoftonline.com",

    // --- Azure US Government ---
    // "junior.msal.cloudInstance": "https://login.microsoftonline.us",

    // --- Azure China ---
    // "junior.msal.cloudInstance": "https://login.partner.microsoftonline.cn",

    // --- Custom sovereign (air-gapped) ---
    // For custom sovereign tenants, set authority + knownAuthorities
    // EXPLICITLY. cloudInstance alone is not enough because MSAL needs to
    // recognize the host as trusted.
    //:
    // "junior.msal.authority": "https://login.microsoftonline...gov/<tenant-guid>",
    // "junior.msal.knownAuthorities": ["login.microsoftonline...gov"],
    //

    // For headless/SSH workstations or restricted-network machines:
    // "junior.msal.interactiveFlow": "device-code",

    // -------------------------------------------------------------------------
    // Sovereign cloud — also matching scope/audience examples
    //
    // Update both authScopes/providerAuthScopes AND the MSAL authority above
    // when targeting a sovereign endpoint.
    //
    //   AzureUSGov AOAI:    https://cognitiveservices.azure.us/.default
    //   AzureChina AOAI:    https://cognitiveservices.azure.cn/.default
    //   custom:      api://<your-gov-apim-app-clientid>/user_impersonation
    //                       (or the .default scope of the gov inference resource)
    // -------------------------------------------------------------------------

    "azureFunctions.showProjectWarning": false
}