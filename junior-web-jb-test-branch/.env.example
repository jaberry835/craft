# Azure OpenAI model connection used by config/agent-connections.json
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=your-chat-deployment
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Optional: only required when config/agent-connections.json sets authMode to "api-key".
AZURE_OPENAI_API_KEY=

# Optional: only required if a configured Azure AI Search source uses API-key auth later.
# The endpoint and index name are configured in the Agent Settings UI.
AZURE_AI_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_AI_SEARCH_INDEX=security-approval-index
AZURE_AI_SEARCH_API_KEY=

# Optional: turn on Cosmos DB-backed storage for agent and connector JSON configuration.
# The app seeds the JuniorWeb database / Agents container from config/*.json on first run.
COSMOS_DB_ENDPOINT=https://your-account.documents.azure.com:443/
COSMOS_DB_DATABASE=JuniorWeb
COSMOS_DB_CONFIG_CONTAINER=Agents
COSMOS_DB_AUTH_MODE=entra

# Optional: turn on Cosmos DB-backed workspace metadata, workspace config,
# chat sessions, and pending changes using separate containers.
COSMOS_DB_WORKSPACE_CONTAINER=Workspaces
COSMOS_DB_WORKSPACE_CONFIG_CONTAINER=WorkspaceConfig
COSMOS_DB_CHAT_CONTAINER=ChatSessions
COSMOS_DB_PENDING_CHANGE_CONTAINER=PendingChanges

# Optional fallback when COSMOS_DB_AUTH_MODE=api-key.
COSMOS_DB_KEY=

# Optional: turn on blob-backed workspace files with a local cache.
# Blob mode can use either a storage connection string or Entra auth via the blob service URL.
JUNIOR_WORKSPACE_STORAGE_BACKEND=blob
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_BLOB_SERVICE_URL=https://your-storage-account.blob.core.windows.net
JUNIOR_WORKSPACE_BLOB_CONTAINER=junior-workspaces
JUNIOR_WORKSPACE_BLOB_PREFIX=workspaces
JUNIOR_WORKSPACE_LOCAL_CACHE_ROOT=/tmp/junior-workspaces-cache

# Optional: turn on Key Vault-backed workspace secrets for connector API keys
# and MCP secret values.
AZURE_KEY_VAULT_URL=https://your-vault-name.vault.azure.net/
JUNIOR_KEY_VAULT_SECRET_PREFIX=junior
